# ─────────────────────────────────────────────────────────────────────────
# Film con IA — variables de entorno
# Copia este archivo a .env.local y rellena los valores desde suscripciones.txt
# (.env.local está en .gitignore — nunca commitees claves reales)
# ─────────────────────────────────────────────────────────────────────────

# ── Texto: slot narrativo/razonamiento (gpt-5.4-pro) ─────────────────────
FOUNDRY_NARRATIVE_ENDPOINT=
FOUNDRY_NARRATIVE_KEY=
FOUNDRY_NARRATIVE_DEPLOYMENT=gpt-5.4-pro
FOUNDRY_NARRATIVE_API_VERSION=2025-04-01-preview

# ── Texto: slot estructurado/JSON (gpt-4.1) — primario Accenture ─────────
ACCENTURE_TEXT_ENDPOINT=
ACCENTURE_TEXT_KEY=
ACCENTURE_TEXT_API_VERSION=2025-01-01-preview
ACCENTURE_GPT41_DEPLOYMENT=gpt-4.1

# ── Texto: fallback estructurado (Azure for Students) ────────────────────
STUDENTS_TEXT_ENDPOINT=
STUDENTS_TEXT_KEY=
STUDENTS_TEXT_API_VERSION=2025-01-01-preview
STUDENTS_GPT41_DEPLOYMENT=gpt-4.1

# ── Imagen: Gemini Nano Banana 2 Lite (primario) ─────────────────────────
GEMINI_FREE_API_KEY=
GEMINI_PAID_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# ── Imagen: FLUX.2-pro (fallback, Azure AI Foundry / Black Forest Labs) ───
ACCENTURE_IMAGE_ENDPOINT=
ACCENTURE_IMAGE_KEY=
ACCENTURE_IMAGE_MODEL=FLUX.2-pro
STUDENTS_IMAGE_ENDPOINT=
STUDENTS_IMAGE_KEY=
STUDENTS_IMAGE_MODEL=FLUX.2-pro

# ── Texto alternativo para el guion: Gemini (AI Studio, nivel gratuito) ───
# Se puede seleccionar en la UI del guion; la key se autocompleta desde aquí.
AISTUDIO_API_KEY=
AISTUDIO_SCRIPT_MODEL=gemini-3.6-flash

# ── Base de datos (SQLite via Prisma) ────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── Directorio de datos (media por proyecto), relativo a la raíz del repo ─
DATA_DIR=./data

# ── Binarios de media (usados desde PATH si se dejan vacíos) ──────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
