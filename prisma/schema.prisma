// Film con IA — modelo de datos (SQLite via Prisma)
// Los campos "array/objeto" se guardan como String JSON para máxima portabilidad
// en SQLite; usar los helpers de src/lib/serialize.ts para (de)serializar.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                String   @id @default(cuid())
  title             String
  idea              String   @default("")
  logline           String   @default("")
  synopsis          String   @default("")
  genre             String   @default("")
  tone              String   @default("")
  language          String   @default("es")
  aspectRatio       String   @default("16:9")
  targetDurationSec Int      @default(60)
  styleBible        String   @default("") // estilo visual, paleta, referencias
  status            String   @default("draft")
  scriptModel       String   @default("gpt-5.4-pro") // modelo elegido para el guion
  scriptJson        String? // guion estructurado (JSON serializado)
  scriptMarkdown    String? // render de solo lectura
  // Montaje: pista de audio opcional del film final
  audioPath         String? // clave relativa del audio subido (música/voz)
  audioMode         String   @default("mix") // mix (mezcla sobre el audio de los clips) | replace
  audioVolume       Float    @default(0.8) // volumen de la pista (0..1), aplicado en modo mix
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  characters    Character[]
  locations     Location[]
  scenes        Scene[]
  exports       Export[]
  timelineClips TimelineClip[]
  agentMessages AgentMessage[]
}

// Conversación del copiloto de IA, por proyecto. Persiste durante toda la
// creación del film; el usuario puede reiniciarla (borra todos los mensajes).
// `proposals` = JSON de las propuestas de edición sugeridas por el asistente
// (cada una: target/id/field/value/summary); se aplican tras confirmación.
model AgentMessage {
  id        String   @id @default(cuid())
  projectId String
  role      String // user | assistant
  content   String   @default("")
  proposals String   @default("[]") // JSON: EditProposal[]
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// Segmento de la línea de tiempo de montaje (EDL no destructiva). Cada segmento
// referencia un clip de origen (Shot.videoPath) con puntos de recorte opcionales.
// Dividir un clip crea dos segmentos con el mismo sourcePath y distinto in/out;
// borrar/reordenar solo toca esta tabla, nunca los archivos de vídeo.
model TimelineClip {
  id           String   @id @default(cuid())
  projectId    String
  order        Int      @default(0)
  sourcePath   String // clave relativa del clip de origen
  sourceShotId String? // plano de origen (para etiqueta/keyframe); informativo
  label        String   @default("")
  inSec        Float? // recorte de entrada (null = desde 0)
  outSec       Float? // recorte de salida (null = hasta el final)
  volume       Float    @default(1) // volumen del clip (0..2 = 0..200%)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Location {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String   @default("") // biblia de objetos: invariantes del lugar (materiales, props, luz)
  imagePath   String? // imagen de REFERENCIA canónica (sin personas); ancla de apariencia
  imagePrompt String?
  locked      Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  encuadres Encuadre[]
  scenes    Scene[]
  shots     Shot[]
}

// Un ENCUADRE es una toma concreta de una Locación (general, cerrado, OTS…),
// imagen SIN personas, generada a partir de la referencia canónica. Reutilizable
// por cualquier plano que necesite esa misma toma.
model Encuadre {
  id           String   @id @default(cuid())
  locationId   String
  label        String   @default("")
  framingPrompt String  @default("") // descripción de la toma usada al generar
  imagePath    String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  shots    Shot[]
}

model Character {
  id                   String   @id @default(cuid())
  projectId            String
  name                 String
  role                 String   @default("")
  canonicalDescription String   @default("") // apariencia fija (ancla de consistencia)
  personality          String   @default("")
  referenceImages      String   @default("[]") // JSON: [{path, kind, provider, prompt}]
  locked               Boolean  @default(false)
  notes                String   @default("")
  order                Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Scene {
  id           String   @id @default(cuid())
  projectId    String
  order        Int
  heading      String   @default("")
  summary      String   @default("")
  characterIds String   @default("[]") // JSON: array de Character.id
  locationId   String? // lugar por defecto de la escena (asignado por LLM); default para sus planos
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  shots    Shot[]
}

model Shot {
  id                String   @id @default(cuid())
  sceneId           String
  order             Int
  actionDescription String   @default("")
  keyframeMoment    String   @default("") // instante exacto de la acción a congelar en el keyframe
  cameraNotes       String   @default("")
  dialogueOrVO      String   @default("")
  characterIds      String   @default("[]") // JSON: array de Character.id
  durationSec       Int      @default(10)
  keyframePath      String?
  encuadreId        String? // toma elegida; null = usar la referencia canónica de la locación efectiva
  locationId        String? // override de locación SOLO para este plano; null = usa el de la escena
  renderMode        String   @default("composite") // composite | direct
  keyframePrompt    String?
  geminiPrompt      String? // prompt de video listo para pegar en Gemini
  assignedAccountId String?
  status            String   @default("planned") // planned|keyframe_ready|package_ready|generated|imported
  videoPath         String?
  notes             String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  scene    Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  account  Account?  @relation(fields: [assignedAccountId], references: [id])
  encuadre Encuadre? @relation(fields: [encuadreId], references: [id], onDelete: SetNull)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
}

model Account {
  id         String   @id @default(cuid())
  label      String
  email      String   @default("")
  dailyQuota Int      @default(3)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  shots  Shot[]
  usages AccountUsage[]
}

model AccountUsage {
  id        String @id @default(cuid())
  accountId String
  date      String // YYYY-MM-DD
  count     Int    @default(0)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
}

model Export {
  id         String   @id @default(cuid())
  projectId  String
  status     String   @default("pending") // pending|running|done|error
  settings   String   @default("{}") // JSON
  outputPath String?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Override en runtime de la configuración de proveedores (endpoints, deployments
// y API keys). Es un almacén clave-valor donde `key` es el MISMO nombre que la
// variable de entorno (p.ej. FOUNDRY_NARRATIVE_KEY). config.ts lee DB ?? env.
// Uso local monousuario: las keys se guardan en claro (mismo modelo de amenaza
// que .env.local); nunca se exponen al cliente sin enmascarar.
model ProviderSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
